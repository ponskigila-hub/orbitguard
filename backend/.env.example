# Comma-separated list of allowed CORS origins.
# Local dev: leave unset (defaults to localhost:3000/3001).
# Production: set to your Vercel deployment URL(s).
# Example: ALLOWED_ORIGINS=https://ogb.vercel.app,https://ogb-git-main-youruser.vercel.app
ALLOWED_ORIGINS=

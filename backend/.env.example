# OGB Backend — environment variables
# Copy this to backend/.env (already git-ignored) and fill in your values.

# Google Gemini API key — required for AI Copilot
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated list of allowed CORS origins.
# Local dev: leave unset — the backend defaults to localhost:3000 and localhost:3001.
# Production: set to your deployed frontend URL(s) if you deploy the app.
# Example: ALLOWED_ORIGINS=https://your-frontend.vercel.app
ALLOWED_ORIGINS=
